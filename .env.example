# HTTP SERVICE ONLY. Never inject this file into the agent or stdio client.
# Load explicitly using Node --env-file. Never commit real secrets.
WORKSPACE_MCP_DATA_SOURCE=synthetic
WORKSPACE_MCP_RESOURCE_URL=https://mcp.example.com/mcp
WORKSPACE_MCP_OAUTH_ISSUER=https://issuer.example.com
WORKSPACE_MCP_OAUTH_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
WORKSPACE_MCP_ALLOWED_SUBJECTS=replace-with-approved-issuer-subject
PORT=3000
# Only for a separate authorized test tenant, on an isolated service host:
# WORKSPACE_MCP_DATA_SOURCE=google
# GOOGLE_WORKSPACE_CUSTOMER_ID=my_customer
# GOOGLE_WORKSPACE_DELEGATED_ADMIN=admin@example.com
# GOOGLE_SERVICE_ACCOUNT_EMAIL=workspace-admin-mcp@example-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
WORKSPACE_MCP_SECURITY_PROFILE=risk
# Optional narrowing. Unknown names fail startup; an empty value denies all tools.
# Known tools outside the selected profile cannot expand it.
WORKSPACE_MCP_ALLOWED_TOOLS=workspace_privileged_user_review
# Optional internal scopes. If omitted, the server derives the minimum scopes for exposed tools.
WORKSPACE_MCP_GRANTED_SCOPES=workspace.users.read,workspace.groups.read,workspace.audit.read
# Inventory profile only: add workspace.group-members.read to expose direct group membership reads.
LOG_LEVEL=info
# Used by npm run dev:traced and npm run start:traced.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
