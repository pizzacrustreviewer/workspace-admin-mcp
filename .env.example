# Copy to .env and fill in. NEVER commit the real .env or your key file.

# Path to a service-account key JSON with domain-wide delegation enabled.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# The admin user the service account impersonates (DWD subject).
WORKSPACE_ADMIN_SUBJECT=admin@yourdomain.com

# 'my_customer' resolves to the delegated admin's own domain.
WORKSPACE_CUSTOMER_ID=my_customer

# Safety: writes are OFF by default. Set to false to allow suspend / group edits.
WORKSPACE_READ_ONLY=true

# When writes are enabled, still simulate by default unless a call passes dry_run=false.
WORKSPACE_DRY_RUN=true

# Transport: 'stdio' for local MCP clients (Claude Desktop / Code), 'streamable-http' for Cloud Run.
MCP_TRANSPORT=stdio
# PORT=8080
